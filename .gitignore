# --- Secrets (never commit) ---
.env
.env.local

# --- Database files ---
*.db
*.sqlite3
users.db

# --- Python cache and compiled files (junk) ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ---
.venv/
venv/
env/

# --- IDE settings (personal editor config) ---
.vscode/
.idea/

# --- OS-generated junk files ---
.DS_Store
Thumbs.db

# --- Local machine config / session logs (contain local paths and user input, should not be committed) ---
launcher_config.json
prompts/optimized prompts/
